BOT_NAME=bybot
APP_ENV=local
BOT_MODE=PAPER
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://bybot:bybot@localhost:5432/bybot
BYBIT_API_KEY=fake_bybit_demo_key_do_not_use
BYBIT_API_SECRET=fake_bybit_demo_secret_do_not_use
BYBIT_ENV=demo
BYBIT_ENABLE_TRADING=false
BYBIT_PUBLIC_BASE_URL=https://api.bybit.com
BYBIT_PRIVATE_DEMO_BASE_URL=https://api-demo.bybit.com
BYBIT_PRIVATE_MAINNET_BASE_URL=https://api.bybit.com
BYBIT_PRIVATE_RECV_WINDOW_MS=5000
BYBIT_PRIVATE_TIMEOUT_SECONDS=5
BYBIT_ACCOUNT_REFRESH_INTERVAL_SECONDS=30
TELEGRAM_BOT_TOKEN=fake_telegram_token_do_not_use
TELEGRAM_CHAT_ID=fake_telegram_chat_id_do_not_use
LLM_API_KEY=fake_llm_key_do_not_use
NEWS_CLASSIFIER_MODE=mock
LLM_PROVIDER_NAME=openai-compatible
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4.1-mini
LLM_CLASSIFIER_VERSION=news-v1
LLM_ALLOW_MOCK_FALLBACK=false
LLM_CACHE_TTL_SECONDS=3600
LLM_TIMEOUT_SECONDS=10
LLM_MAX_RETRIES=2
LLM_BACKOFF_BASE_SECONDS=0.5
LLM_RATE_LIMIT_PER_MINUTE=20
LLM_MAX_CONCURRENT_REQUESTS=2
LLM_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
LLM_CIRCUIT_BREAKER_COOLDOWN_SECONDS=60
LLM_MAX_INPUT_CHARACTERS=4000
LLM_MAX_OUTPUT_TOKENS=250
LLM_HOURLY_REQUEST_BUDGET=100
LLM_DAILY_REQUEST_BUDGET=500
LLM_DAILY_TOKEN_BUDGET=100000
CODEX_CLI_ENABLED=false
CODEX_CLI_PATH=codex
CODEX_CLI_MODEL=gpt-5.4-mini
CODEX_CLI_FALLBACK_MODEL=gpt-5.6-luna
CODEX_CLI_REASONING_EFFORT=low
CODEX_CLI_FALLBACK_MIN_CONFIDENCE=0.75
CODEX_CLI_MIN_NEWS_IMPORTANCE=0.70
NEWS_POLL_INTERVAL_SECONDS=60
NEWS_MAX_ITEM_AGE_MINUTES=60
NEWS_MIN_IMPORTANCE_TO_CLASSIFY=0.3
NEWS_ENABLE_RSS=true
NEWS_RSS_URLS=["https://cointelegraph.com/rss"]
NEWS_ENABLE_MOCK_CLASSIFIER=true
TEST_MODE=false
AUTO_PAPER_EXECUTION=false
SIGNAL_MIN_CLASSIFICATION_CONFIDENCE=0.80
SIGNAL_MIN_NEWS_IMPORTANCE=0.70
SIGNAL_TTL_SECONDS=300
SIGNAL_CONFIRMATION_WINDOW_SECONDS=60
SIGNAL_REEVALUATION_INTERVAL_SECONDS=5
SIGNAL_CONFLICT_THRESHOLD_PCT=0.30
SIGNAL_MIN_EXPECTED_EDGE_BPS=12
SIGNAL_DEFAULT_STOP_LOSS_PCT=0.5
SIGNAL_DEFAULT_TAKE_PROFIT_PCT=1.0
ALLOWED_SYMBOLS=["BTCUSDT","ETHUSDT"]
MARKET_DATA_PROVIDER=MOCK
MARKET_DATA_TIMEOUT_SECONDS=5
MARKET_DATA_HISTORY_LIMIT=120
TRADING_PAUSED=false
PAPER_STARTING_EQUITY_USDT=10000
PAPER_DAILY_PNL_PCT=0
PAPER_WEEKLY_PNL_PCT=0
PAPER_CONSECUTIVE_LOSSES=0
PAPER_TAKE_PROFIT_PCT=1.0
PAPER_POSITION_TIMEOUT_MINUTES=60
DEFAULT_PAPER_FEES_BPS=6
DEFAULT_SLIPPAGE_BPS=2
PAPER_MAKER_FEE_BPS=2
PAPER_TAKER_FEE_BPS=6
PAPER_SLIPPAGE_BPS=2
MIN_NET_EDGE_BPS=5
MAX_POSITION_NOTIONAL_USDT=5000
MAX_POSITION_NOTIONAL_PCT_OF_EQUITY=5
MIN_POSITION_NOTIONAL_USDT=10
MAX_RISK_PER_TRADE_PCT=0.5
MAX_DAILY_LOSS_PCT=2.0
MAX_WEEKLY_LOSS_PCT=5.0
MAX_LEVERAGE=2
MAX_SPREAD_BPS=8
MIN_LLM_CONFIDENCE=0.70
MIN_EXPECTED_EDGE_BPS=12
